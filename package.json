{
  "name": "seabattle-arena",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "description": "Морской бой против бота с ELO-рейтингом — vanilla HTML/CSS/JS",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "server": "deno run --allow-net --allow-env server/main.ts",
    "test": "node --test tests/",
    "test:online": "node scripts/online-smoke.mjs",
    "icons": "python scripts/make-icons.py && python scripts/make-android-icons.py",
    "android:icons": "python scripts/make-android-icons.py",
    "shots": "node scripts/screenshots.mjs",
    "www": "node scripts/build-www.mjs",
    "yandex": "node scripts/build-yandex.mjs",
    "yandex:promo": "node scripts/make-yandex-promo.mjs",
    "gamepush": "node scripts/build-gamepush.mjs",
    "gamepush:demo": "node scripts/build-gamepush.mjs --demo",
    "vk:assets": "node scripts/vk-assets.mjs",
    "vk:snippet": "python scripts/make-vk-snippet.py",
    "gamepush:assets": "python scripts/make-gamepush-assets.py && python scripts/make-gamepush-screens.py",
    "gamepush:video": "node scripts/gamepush-video.mjs",
    "gamepush:video:landscape": "node scripts/gamepush-video-landscape.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "android:sync": "npm run www && cap sync android",
    "android:apk": "node scripts/build-apk.mjs",
    "ios:ipa": "node scripts/build-ipa.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0"
  }
}
